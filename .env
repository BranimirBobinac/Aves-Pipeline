

# MongoDB
MONGO_URI=mongodb://mongouser:mongopass123@localhost:27017/
MONGO_DB=birds_db

# MinIO (S3-kompatibilni storage)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_AUDIO=bird-audio          # Bucket za audio datoteke
MINIO_BUCKET_LOGS=bird-logs            # Bucket za logove klasifikacija
MINIO_USE_SSL=false

# Kafka
KAFKA_BROKER=localhost:9092
KAFKA_TOPIC=bird-observations          # Topic s opažanjima ptica

# External API
AVES_BASE_URL=https://aves.regoch.net

# Lokalni direktorij s audio datotekama
AUDIO_DIR=./audio_samples

# Geografska lokacija za audio datoteke (defaultna)
AUDIO_LOCATION_LAT=45.8150            # Zagreb koordinate
AUDIO_LOCATION_LON=15.9819
